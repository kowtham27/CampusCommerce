# --- Database (Supabase Postgres) — see instruction.md for how to get these ---
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Only emails ending in this domain may register (no real university hard-coded)
ALLOWED_EMAIL_DOMAIN="university.edu"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: Supabase Storage for real image uploads ---
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"

# --- Optional: future integrations (not required for the demo) ---
# PAYMENT_KEY=
# AI_API_KEY=
