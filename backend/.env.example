# --- Server ---
PORT=4000
NODE_ENV=development

# The Next.js frontend origin (used for CORS when the API is called directly).
FRONTEND_URL="http://localhost:3000"

# --- Database (local PostgreSQL — `docker compose up -d db` from the repo root) ---
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_commerce?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32   (required when NODE_ENV=production)
SESSION_SECRET="replace-with-a-long-random-string"

# Only emails ending in this domain may register.
ALLOWED_EMAIL_DOMAIN="university.edu"

# --- Uploads ---
# Listing photos are stored on disk here and served at /uploads/*.
UPLOAD_DIR="uploads"
